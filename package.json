{
  "name": "obold",
  "version": "1.0.0-beta",
  "description": "Sovereign Emergency Continuity & Dead Man's Switch Daemon (Beta) by BCN Studio",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "obold": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts run",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun build --compile --minify --target=bun --outfile=bin/obold src/index.ts",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 --outfile=dist/obold-linux-x64 src/index.ts",
    "build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 --outfile=dist/obold-linux-arm64 src/index.ts",
    "build:darwin-x64": "bun build --compile --minify --target=bun-darwin-x64 --outfile=dist/obold-darwin-x64 src/index.ts",
    "build:darwin-arm64": "bun build --compile --minify --target=bun-darwin-arm64 --outfile=dist/obold-darwin-arm64 src/index.ts",
    "build:windows-x64": "bun build --compile --minify --target=bun-windows-x64 --outfile=dist/obold-windows-x64.exe src/index.ts",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BCN-Studio/obold.git"
  },
  "homepage": "https://bcnstudio.tech",
  "author": "BCN Studio (https://bcnstudio.tech)",
  "license": "SEE LICENSE IN LICENSE"
}
